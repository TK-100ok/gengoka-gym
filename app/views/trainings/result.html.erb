<h1 class="text-3xl font-bold text-amber-500 text-center mb-8">
  AIフィードバック
</h1>

<% feedback = @training.ai_feedback %>

<!-- スコア -->
<div class="text-center mb-10">
  <p class="text-5xl font-bold text-amber-500">
    <%= feedback.score %>
    <span class="text-2xl">点</span>
  </p>
</div>

<section class="mb-8">
  <h2 class="text-xl font-bold text-gray-700 mb-3">
    📝 総評
  </h2>

  <hr class="mb-4">

  <p class="text-gray-700 whitespace-pre-line leading-8">
    <%= feedback.overall_comment %>
  </p>
</section>

<section class="mb-8">
  <h2 class="text-xl font-bold text-green-600 mb-3">
    👍 良い点
  </h2>

  <hr class="mb-4">

  <p class="text-gray-700 whitespace-pre-line leading-8">
    <%= feedback.good_points %>
  </p>
</section>

<section>
  <h2 class="text-xl font-bold text-red-600 mb-3">
    🔧 改善点
  </h2>

  <hr class="mb-4">

  <p class="text-gray-700 whitespace-pre-line leading-8">
    <%= feedback.improvement_points %>
  </p>
</section>