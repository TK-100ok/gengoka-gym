<%= render "training_detail", training: @training %>

<div class="mt-10 grid grid-cols-2 gap-4 max-w-md mx-auto">
  <div class="text-center">
    <%= render "shared/back_button",
      text: "履歴に戻る",
      path: trainings_path %>
  </div>

  <% if @training.post.present? %>

    <%= button_to "投稿を取り消す",
      training_post_path(@training),
      method: :delete,
      class: "w-full mx-auto block px-5 py-3 bg-red-400 hover:bg-red-500 text-white font-semibold rounded-lg" %>

  <% else %>

    <%= button_to "投稿する",
      training_post_path(@training),
      method: :post,
      class: "w-full mx-auto block px-5 py-3 bg-emerald-400 hover:bg-emerald-500 font-semibold rounded-lg" %>

  <% end %>
</div>