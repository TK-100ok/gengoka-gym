<%= render "training_detail", training: @training %>

<div class="mt-10">
  <% if @training.post.present? %>

    <%= button_to "投稿を取り消す",
      training_post_path(@training),
      method: :delete,
      class: "mx-auto block px-5 py-3 bg-gray-400 hover:bg-gray-500 text-white font-bold rounded-lg" %>

  <% else %>

    <%= button_to "投稿する",
      training_post_path(@training),
      method: :post,
      class: "mx-auto block px-5 py-3 bg-amber-400 hover:bg-amber-500 text-white font-bold rounded-lg" %>

  <% end %>
</div>