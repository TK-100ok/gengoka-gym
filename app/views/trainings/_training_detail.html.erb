<% feedback = training.ai_feedback %>

<div class="max-w-4xl mx-auto bg-white rounded-2xl shadow p-8">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-amber-500">
      トレーニング詳細
    </h1>

    <%= render "favorites/favorite_button", training: @training %>
  </div>

  <!-- 日付 -->
  <p class="text-md text-gray-400 mb-8">
    <%= training.created_at.strftime("%Y/%m/%d %H:%M") %>
  </p>

  <% if feedback.present? %>
    <section class="text-center mb-10">
      <p class="text-sm text-gray-500">
        AIスコア
      </p>

      <p class="text-6xl font-bold text-amber-500 mt-2">
        <%= feedback.score %>
      </p>

      <p class="text-gray-500">
        /100 点
      </p>
    </section>
  <% end %>

  <hr class="mb-8">

  <div class="mb-6 grid grid-cols-1 md:grid-cols-2 gap-4">
    <section class="mb-8">
      <h2 class="text-lg text-amber-700 font-semibold mb-2">
        テーマ
      </h2>

      <p class="inline-flex px-4 py-2 rounded-full text-xl font-bold">
        <%= training.theme %>
      </p>
    </section>

    <section class="mb-8">
      <h2 class="text-lg text-amber-700 font-semibold mb-2">
        説明する相手
      </h2>

      <span class="inline-flex px-4 py-2 rounded-full bg-amber-100 text-xl font-bold">
        <%= training.display_target %>
      </span>
    </section>
  </div>

  <section class="mb-10">
    <h2 class="text-lg text-amber-700 font-semibold mb-3">
      説明内容
    </h2>

    <div class="text-lg bg-amber-100 rounded-xl p-5 leading-relaxed whitespace-pre-wrap font-bold">
      <%= training.explanation %>
    </div>
  </section>

  <hr class="mb-8">

  <!-- AIフィードバック -->
  <% if feedback.present? %>
    <section class="space-y-8">
      <div>
        <h2 class="text-xl font-bold text-green-600 mb-2">
          良い点
        </h2>

        <p class="text-lg border border-green-200 bg-green-50 rounded-xl p-5 leading-relaxed whitespace-pre-wrap font-bold">
          <%= feedback.good_points %>
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-red-600 mb-2">
          改善点
        </h2>

        <p class="text-lg border border-red-200 bg-red-50 rounded-xl p-5 leading-relaxed whitespace-pre-wrap font-bold">
          <%= feedback.improvement_points %>
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-amber-600 mb-2">
          総評
        </h2>

        <p class="text-lg border border-amber-300 bg-amber-200 rounded-xl p-5 leading-relaxed whitespace-pre-wrap font-bold">
          <%= feedback.overall_comment %>
        </p>
      </div>
    </section>
  <% end %>
</div>