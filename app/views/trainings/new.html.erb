<div data-controller="loading">
  <div class="flex flex-col sm:flex-row justify-between items-start mb-6 gap-4 sm:gap-0">
    <div>
      <h1 class="text-2xl sm:text-4xl font-bold text-amber-500">
        言語化トレーニング
      </h1>

      <p class="text-gray-500 mt-4 sm:mt-6">
        テーマと相手を決めて、相手に伝える形で書いてみましょう。
      </p>
    </div>

    <div
      class="rounded-lg px-4 py-2 text-sm font-semibold text-center
        <%= @remaining_ai_usage.zero? ?
          'bg-red-100 text-red-700 border border-red-300' :
          'bg-amber-100 text-amber-700 border border-amber-300' %>">

      AIフィードバック<br>
      利用可能回数<br>

      <span class="text-lg">
        残り <%= @remaining_ai_usage %> 回
      </span>
    </div>
  </div>

  <!--ローディングアニメーション画面 -->
  <div data-loading-target="overlay" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-white/80 backdrop-blur-sm">
    <div class="text-center">
      <div class="mx-auto h-16 w-16 animate-spin rounded-full border-4 border-amber-200 border-t-amber-500">
      </div>

      <p class="mt-6 text-xl font-bold text-amber-600">
        AIフィードバックを生成しています
      </p>

      <p class="mt-2 text-gray-500">
        少々お待ちください...
      </p>
    </div>
  </div>

  <%= form_with model: @training, url: trainings_path, local: true, data: {action: "submit->loading#show" }  do |f| %>
    <div class="space-y-5">

      <% if @training.errors.any? %>
        <div class="bg-red-100 text-red-700 p-4 rounded-lg max-w-lg mx-auto">
          <ul>
            <% @training.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :theme, "テーマ", class: "block text-lg font-semibold text-gray-700 mb-1" %>
          <p class="text-gray-500 mb-2">
            説明したい内容を入力してください。
          </p>
          <%= f.text_field :theme,
            placeholder: "例：良いリーダーとは",
            class: "w-full bg-white px-4 py-3 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400" %>
        </div>

        <div>
          <%= f.label :target_id, "説明する相手", class: "block text-lg font-semibold text-gray-600 mb-1" %>
          <p class="text-gray-500 mb-2">
            誰に対して説明するかを選択、または入力してください。
          </p>

          <%= f.collection_select :target_id, @targets, :id, :name, {},
            class: "w-full bg-white px-4 py-3 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400" %>

          <div id="custom-target-field" class="<%= 'hidden' unless @training.target&.name == 'その他' %>">
            <%= f.label :custom_target, "その他の相手", class: "block text-md font-semibold text-gray-600 mb-1 mt-5" %>
            <%= f.text_field :custom_target,
              placeholder: "説明したい相手を入力してください",
              class: "w-full bg-white px-4 py-3 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400" %>
          </div>
        </div>
      </div>

      <div data-controller="character-counter">
        <%= f.label :explanation, "説明内容", class: "block text-lg font-semibold text-gray-600 mb-1" %>
        <%= f.text_area :explanation,
          placeholder: "相手に合わせて説明してみましょう",
          class: "w-full bg-white h-40 px-4 py-2 border border-amber-200 rounded-lg focus:ring-2 focus:ring-amber-400",
          data: { action: "input->character-counter#count", character_counter_target: "textarea" } %>

        <p class="mt-2 text-sm text-gray-500 text-right" data-character-counter-target="counter">
          0 / 600文字
        </p>
      </div>

      <%= f.submit "保存してフィードバックをもらう",
        class: "mx-auto block bg-amber-400 hover:bg-amber-500 text-white font-bold px-10 py-3 rounded-lg",
        data: { loading_target: "submit" } %>

    </div>
  <% end %>
</div>