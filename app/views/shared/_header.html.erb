<header class="top-0 left-0 w-full h-20 bg-gray-800 text-white shadow-md z-50">
  <div class="max-w-7xl mx-auto h-full flex items-center justify-between px-8">

    <!-- ロゴ -->
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <%= image_tag "logo.png", class: "w-15 h-15" %>
      <span class="text-2xl font-bold border-gray-700 text-yellow-400">
        言語化ジム
      </span>
    <% end %>

    <!-- メニュー -->
    <% if user_signed_in? %>

      <nav class="flex items-center gap-8">
        <%= link_to "トレーニング", home_path, class: "hover:text-amber-500 transition" %>
        <%= link_to "履歴", trainings_path, class: "hover:text-amber-500 transition" %>
        <%= link_to "投稿一覧", posts_path, class: "hover:text-amber-500 transition" %>
        <%= link_to "お気に入り", favorites_path, class: "hover:text-amber-500 transition" %>
      </nav>

      <div class="flex items-center gap-4">
        <%= link_to settings_path, class: "flex items-center gap-2 hover:text-amber-500 transition" do %>
        <%= lucide_icon "circle-user-round", class: "w-7 h-7" %>
        <span>プロフィール</span>
        <% end %>

        <%= link_to "ログアウト",
        destroy_user_session_path,
        data: { turbo_method: :delete },
        class: "bg-amber-400 hover:bg-amber-500 text-white px-4 py-2 rounded-lg font-bold" %>
      </div>

    <% else %>

      <div class="flex items-center gap-4">
        <%= link_to "ログイン",
        new_user_session_path,
        class: "hover:text-amber-400 transition" %>

        <%= link_to "無料で始める",
        new_user_registration_path,
        class: "bg-amber-400 hover:bg-amber-500 text-white px-5 py-2 rounded-lg font-bold" %>
      </div>

    <% end %>

  </div>
</header>