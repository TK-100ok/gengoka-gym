<div class="min-h-screen flex items-center justify-center bg-amber-50 px-4">
  <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-md">

    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">
      新規登録
    </h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>

      <% if flash[:alert] %>
        <div class="bg-red-100 text-red-700 p-4 rounded-lg">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if resource.errors.any? %>
      <div class="bg-red-100 text-red-700 p-4 rounded-lg">
        <ul>
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
      <% end %>

      <div>
        <%= f.label :name, "ユーザー名", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mb-1">
            <%= @minimum_password_length %>文字以上で入力してください
          </p>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "パスワード確認", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.submit "アカウント作成",
          class: "w-full bg-blue-500 text-white py-2 rounded-lg font-semibold hover:bg-blue-600 transition" %>
      </div>

    <% end %>

    <!-- Googleログイン区切り -->
    <div class="flex items-center gap-4 my-6">
      <div class="h-px flex-1 bg-gray-200"></div>
      <span class="text-sm font-semibold text-gray-400">または</span>
      <div class="h-px flex-1 bg-gray-200"></div>
    </div>

    <div class="text-center mt-4">
      <%= button_to user_google_oauth2_omniauth_authorize_path,
                    form: { data: { turbo: false } },
                    method: :post,
                    class: "w-full inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 py-2 rounded-lg font-semibold hover:bg-gray-50 transition" do %>
          <svg class="mr-2" width="20" height="20" viewBox="0 0 48 48">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
          </svg>
        <span>Googleでログイン</span>
      <% end %>
    </div>

    <!-- Links -->
    <div class="mt-6 text-center text-sm text-gray-600">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
