<div class="min-h-screen flex items-center justify-center bg-amber-50 px-4">
  <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-md">

    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">
      パスワードを再設定
    </h2>

    <%= form_for(resource,
      as: resource_name,
      url: password_path(resource_name),
      html: { method: :put, class: "space-y-5" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.hidden_field :reset_password_token %>

      <div>
        <%= f.label :password, "新しいパスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password,
          autofocus: true,
          autocomplete: "new-password",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "新しいパスワード（確認）", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password_confirmation,
          autocomplete: "new-password",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.submit "パスワードを更新", class: "w-full bg-amber-400 text-white py-2 rounded-lg font-semibold hover:bg-amber-500 transition" %>
      </div>

    <% end %>

  </div>
</div>