<%- if controller_name != 'sessions' %>
  <p><%= link_to "ログインはこちら", new_session_path(resource_name), class: "text-blue-500 hover:text-blue-600 underline" %></p>
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p><%= link_to "アカウントをお持ちでない方はこちら", new_registration_path(resource_name), class: "text-blue-500 hover:text-blue-600 underline" %></p>
<% end %>

