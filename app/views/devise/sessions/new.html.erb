<div class="min-h-screen flex items-center justify-center bg-amber-50 px-4">
  <div class="w-full max-w-md bg-white p-8 rounded-2xl shadow-md">
    
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">
      ログイン
    </h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>

      <% if flash[:alert] %>
        <div class="bg-red-100 text-red-700 p-4 rounded-lg">
          <%= flash[:alert] %>
        </div>
      <% end %>

      <% if resource.errors.any? %>
      <div class="bg-red-100 text-red-700 p-4 rounded-lg">
        <ul>
          <% resource.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
      <% end %>

      <div>
        <%= f.label :email, "メールアドレス", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password",
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-400 focus:outline-none" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between text-sm">
          <label class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
            <span class="text-gray-600">ログイン状態を保持</span>
          </label>
        </div>
      <% end %>

      <div>
        <%= f.submit "ログイン",
          class: "w-full bg-blue-500 text-white py-2 rounded-lg font-semibold hover:bg-blue-600 transition" %>
      </div>

    <% end %>

    <!-- Googleログイン区切り -->
    <div class="flex items-center gap-4 my-6">
      <div class="h-px flex-1 bg-gray-200"></div>
      <span class="text-sm font-semibold text-gray-400">または</span>
      <div class="h-px flex-1 bg-gray-200"></div>
    </div>

    <div class="text-center">
      <%= button_to "Googleでログイン",
                  user_google_oauth2_omniauth_authorize_path,
                  form: { data: { turbo: false } },
                  method: :post,
                  class: "w-full inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 py-2 rounded-lg font-semibold hover:bg-gray-50 transition" %>
    </div>

    <!-- Links -->
    <div class="mt-6 text-center text-sm">
      <%= link_to "パスワードをお忘れですか？",
        new_user_password_path,
        class: "text-gray-500 hover:text-amber-500 transition" %>
    </div>

  </div>
</div>
