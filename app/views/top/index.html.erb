<div class="flex flex-col px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6 bg-amber-50 text-gray-800">
  <section class="relative h-[600px] rounded-3xl overflow-hidden shadow-xl">
    <div>
      <%= image_tag "top.png", class: "absolute inset-0 w-full h-full object-cover object-[40%_center] sm:object-center" %>
    </div>

    <!-- 黒オーバーレイ -->
    <div class="absolute inset-0 bg-black/45"></div>

    <div class="relative z-10 flex h-full flex-col items-center justify-center text-center px-6">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight mb-8">
        伝わる説明は、<br>
        練習で身につく。
      </h1>

      <p class="text-base sm:text-md lg:text-xl text-gray-100 leading-relaxed mb-10">
        AI評価で言語化力を鍛える<br>
        言語化トレーニングサービス
      </p>

      <div class="flex flex-col sm:flex-row gap-4">

        <% if user_signed_in? %>
          <%= link_to "トレーニングを始める", home_path, class: "bg-amber-400 hover:bg-amber-500 text-white px-8 py-3 sm:px-10 sm:py-4 rounded-xl font-bold shadow-lg" %>
          <%= link_to "みんなの投稿を見る", posts_path, class: "bg-white hover:bg-gray-100 text-amber-500 px-8 py-3 sm:px-10 sm:py-4 rounded-xl font-bold shadow-lg" %>
        <% else %>
          <%= link_to "ログイン", new_user_session_path, class: "bg-amber-400 hover:bg-amber-500 text-white px-8 py-3 sm:px-10 sm:py-4 rounded-xl font-bold shadow-lg" %>
          <%= link_to "無料で始める", new_user_registration_path, class: "bg-white hover:bg-gray-100 text-amber-500 px-8 py-3 sm:px-10 sm:py-4 rounded-xl font-bold shadow-lg" %>
        <% end %>

      </div>
    </div>
  </section>

  <section class="py-16 sm:py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-center mb-10">
        言語化ジムとは？
      </h2>

      <p class="text-center text-gray-500 max-w-3xl mx-auto mb-10 sm:mb-16 leading-relaxed">
        言語化ジムは、AIフィードバックを受けながら言語化力を鍛えられる
        トレーニングサービスです。
      </p>

      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        <div class="bg-white rounded-2xl shadow-md p-6 sm:p-8 text-center">
          <div class="mb-5 flex justify-center">
            <%= lucide_icon "bot-message-square", class: "w-14 h-14 text-amber-500" %>
          </div>

          <h3 class="text-xl font-bold mb-4">
            テーマと相手
          </h3>

          <p class="text-gray-600">
            テーマと相手を設定できるので、相手に合わせた伝え方を練習できます。
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-md p-6 sm:p-8 text-center">
          <div class="mb-5 flex justify-center">
            <%= lucide_icon "bot-message-square", class: "w-14 h-14 text-amber-500" %>
          </div>

          <h3 class="text-xl font-bold mb-4">
            AIフィードバック
          </h3>

          <p class="text-gray-600">
            説明内容をAIが分析し、良い点・改善点を分かりやすくフィードバックします。
          </p>
        </div>

        <div class="bg-white rounded-2xl shadow-md p-6 sm:p-8 text-center">
          <div class="mb-5 flex justify-center">
            <%= lucide_icon "notebook-pen", class: "w-14 h-14 text-amber-500" %>
          </div>

          <h3 class="text-xl font-bold mb-4">
            投稿で学べる
          </h3>

          <p class="text-gray-600">
            他のユーザーの説明やAIフィードバックを見て、新しい表現を学べます。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 border-t border-border-color">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-5xl font-bold mb-10">
        使い方
      </h2>

      <p class="text-gray-500 mb-16">
        3ステップで簡単にトレーニングできます
      </p>

      <div class="grid md:grid-cols-3 gap-10">
        <div>
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-amber-200 flex items-center justify-center text-2xl font-bold text-amber-600">
            1
          </div>

          <h3 class="text-xl font-bold mb-3">
            テーマと相手を設定
          </h3>

          <p class="text-gray-600">
            説明したいテーマと <br>
            「誰に説明するか」を設定します
          </p>
        </div>

        <div>
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-amber-200 flex items-center justify-center text-2xl font-bold text-amber-600">
            2
          </div>

          <h3 class="text-xl font-bold mb-3">
            説明を入力
          </h3>

          <p class="text-gray-600">
            設定した相手を意識しながら <br>
            相手に伝わるように説明を入力します
          </p>
        </div>

        <div>
          <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-amber-200 flex items-center justify-center text-2xl font-bold text-amber-600">
            3
          </div>

          <h3 class="text-xl font-bold mb-3">
            AIフィードバック
          </h3>

          <p class="text-gray-600">
            相手に伝わりやすい説明になっているかを <br>
            AIが客観的に評価してくれます
          </p>
        </div>
      </div>

      <div class="mt-24">
        <% if user_signed_in? %>
          <%= link_to "トレーニングを始める", home_path, class: "inline-block bg-amber-400 hover:bg-amber-500 text-white px-12 py-4 rounded-xl font-bold shadow-lg" %>
        <% else %>
          <%= link_to "今すぐ始める", new_user_registration_path, class: "inline-block bg-amber-400 hover:bg-amber-500 text-white px-12 py-4 rounded-xl font-bold shadow-lg" %>
        <% end %>
      </div>

    </div>
  </section>
</div>