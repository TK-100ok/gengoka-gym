<%= render "trainings/training_detail", training: @training %>

<% own_post = @post.user == current_user %>

<div class="mt-10 <%= own_post ? 'grid grid-cols-2 gap-4 max-w-md mx-auto' : 'flex justify-center' %>">

  <%= render "shared/back_button",
      text: "みんなの投稿に戻る",
      path: posts_path %>

  <% if own_post %>
    <%= button_to "投稿を取り消す",
      training_post_path(@training),
      method: :delete,
      class: "w-full px-5 py-3 bg-red-400 hover:bg-red-500 text-white font-semibold rounded-lg" %>
  <% end %>

</div>
