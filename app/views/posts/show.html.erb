<%= render "trainings/training_detail", training: @training %>

<div class="mt-10">
  <% if @post.user == current_user %>
    <%= button_to "投稿を取り消す",
      training_post_path(@training),
      method: :delete,
      class: "mx-auto block px-5 py-2 rounded-lg bg-rose-100 hover:bg-rose-200 text-rose-700 font-semibold transition-colors" %>
  <% end %>
</div>